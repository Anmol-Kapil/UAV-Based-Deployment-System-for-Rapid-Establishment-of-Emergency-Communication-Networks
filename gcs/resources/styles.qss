/* Professional Engineering GCS Dark Theme */

QMainWindow {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 12px;
}

QWidget {
    background-color: #0d1117;
    color: #c9d1d9;
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 12px;
}

/* Top Status Bar */
#topStatusBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
    padding: 4px 8px;
    min-height: 40px;
    max-height: 48px;
}

.status-badge {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 3px 8px;
    font-weight: 600;
    font-size: 11px;
}

.status-badge-disconnected {
    background-color: rgba(248, 81, 73, 0.15);
    border: 1px solid #f85149;
    color: #ff7b72;
}

.status-badge-connected {
    background-color: rgba(46, 160, 67, 0.15);
    border: 1px solid #2ea043;
    color: #56d364;
}

.status-badge-warning {
    background-color: rgba(210, 153, 34, 0.15);
    border: 1px solid #d29922;
    color: #e3b341;
}

.status-badge-safe {
    background-color: rgba(56, 139, 253, 0.15);
    border: 1px solid #388bfd;
    color: #79c0ff;
}

.status-badge-simulation {
    background-color: #21262d;
    border: 1px solid #383e47;
    color: #8b949e;
}

/* Bottom Flight Control Bar */
#bottomBar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
    padding: 6px 12px;
    min-height: 52px;
}

/* Tool Panel / Sidebar */
#leftPanel {
    background-color: #161b22;
    border-right: 1px solid #30363d;
}

/* Section Box / Grouping */
.section-box {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-bottom: 8px;
}

.section-header {
    background-color: #21262d;
    color: #f0f6fc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 6px 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom: 1px solid #30363d;
}

/* Buttons */
QPushButton {
    background-color: #21262d;
    border: 1px solid #363b42;
    border-radius: 4px;
    color: #c9d1d9;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 11px;
    min-height: 18px;
}

QPushButton:hover:!disabled {
    background-color: #30363d;
    border-color: #8b949e;
    color: #f0f6fc;
}

QPushButton:pressed:!disabled {
    background-color: #1f242c;
    border-color: #58a6ff;
}

QPushButton:disabled {
    background-color: #161b22;
    border-color: #21262d;
    color: #484f58;
}

/* Action Control Buttons (Bottom Bar) */
.btn-flight {
    min-height: 26px;
    padding: 6px 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-size: 11px;
}

.btn-flight-arm {
    border-color: #2ea043;
}

.btn-flight-arm:hover:!disabled {
    background-color: rgba(46, 160, 67, 0.2);
    border-color: #3fb950;
    color: #3fb950;
}

.btn-flight-abort {
    border-color: #f85149;
}

.btn-flight-abort:hover:!disabled {
    background-color: rgba(248, 81, 73, 0.2);
    border-color: #ff7b72;
    color: #ff7b72;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #30363d;
    background-color: #161b22;
    top: -1px;
}

QTabBar::tab {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-bottom: none;
    color: #8b949e;
    padding: 7px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 600;
    font-size: 11px;
}

QTabBar::tab:selected {
    background-color: #161b22;
    color: #58a6ff;
    border-top: 2px solid #58a6ff;
}

QTabBar::tab:hover:!selected {
    background-color: #1c2128;
    color: #c9d1d9;
}

/* Telemetry Grid & Readouts */
.telemetry-card {
    background-color: #0d1117;
    border: 1px solid #21262d;
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.telemetry-label {
    color: #8b949e;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.telemetry-value {
    color: #58a6ff;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 15px;
    font-weight: 700;
}

.telemetry-unit {
    color: #8b949e;
    font-size: 11px;
    font-weight: 400;
    margin-left: 2px;
}

/* Tables (Event Log, Mission Waypoints) */
QTableWidget {
    background-color: #0d1117;
    border: 1px solid #30363d;
    gridline-color: #21262d;
    color: #c9d1d9;
    font-family: "Consolas", monospace;
    font-size: 11px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #21262d;
    border-bottom: 1px solid #30363d;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #0d1117;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #30363d;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Splitter */
QSplitter::handle {
    background-color: #21262d;
}

QSplitter::handle:hover {
    background-color: #58a6ff;
}

/* Camera Placeholder Box */
#cameraPlaceholder {
    background-color: #05070a;
    border: 1px dashed #30363d;
    border-radius: 6px;
}
